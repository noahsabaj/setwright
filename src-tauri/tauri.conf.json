{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Setwright",
  "version": "0.2.0",
  "identifier": "org.setwright.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/build.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost blob: data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Setwright",
        "width": 1440,
        "height": 920,
        "minWidth": 360,
        "minHeight": 480,
        "zoomHotkeysEnabled": true,
        "resizable": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Write papers, not TeX.",
    "longDescription": "A local-first visual editor for standard LaTeX research papers.",
    "copyright": "Copyright Setwright contributors",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser", "displayLanguageSelector": false } },
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/noahsabaj/setwright/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhFQUMxNTVCQTQyRjQ5MkEKUldRcVNTK2tXeFdzanRPblROa1hYaytaY0NHajhoUkVUSWpoT1lURTA4NUYvMXpDTzFzR2JKL2sK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
